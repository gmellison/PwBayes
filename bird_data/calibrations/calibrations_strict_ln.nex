    calibrate fossilA   = offsetexponential(7.2  ,  90);    
    calibrate fossilB   = offsetexponential(13.6 ,  90);    
    calibrate fossilC   = offsetexponential(53.5 ,  90);    
    calibrate fossilD   = offsetexponential(56.8 ,  90);    
