    constraint fossil5 = 29 68;
    constraint fossil6 = 116 86;
    constraint fossil7 = 107 16 58 117;
    constraint fossil8 = 94 59;
    constraint fossil9 = 82 100 50;
    constraint fossil10 = 97 52 109;
    constraint fossil11 = 31 120;
    constraint fossil12 = 41 74 13 75 53 65 60 90 103 22 123;
    constraint fossil13 = 53 65;
    constraint fossil14 = 60 90 103;
    constraint fossil15 = 22 123;
    constraint fossil20 = 4 93 85 39 38 76 34 96 89 47 61 24 30 11 8 10 9 7 21;

    calibrate alligator = uniform(255.31,299.8);
