    calibrate fossil7   = offsetexponential(60.5 ,  90);    
    calibrate fossil8   = offsetexponential(51.58,  90);    
    calibrate fossil9   = offsetexponential(53.9 ,  90);    
    calibrate fossil10  = offsetexponential(55.6 ,  90);    
    calibrate fossil11  = offsetexponential(51.58,  90);    
    calibrate fossil12  = offsetexponential(56.22,  90);    
    calibrate fossil13  = offsetexponential(51.57,  90);    
    calibrate fossil14  = offsetexponential(28.3 ,  90);    
