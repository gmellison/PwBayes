begin mrbayes;
log start filename=full_strict_ln.log;

execute ../bird_matrix.nex;
execute ../bird.tree;    [read in tree] 
execute ../calibrations/calibrations_strict_ln.nex; 

prset brlenspr=clock:birthdeath;  
prset topologypr=constraints(  
    alligator  ,               
    paleo  ,                   
    fossil3  ,                 
    fossil4  ,                 
    fossil5  ,                 
    fossil6  ,                 
    fossil7  ,                 
    fossil8  ,                 
    fossil9  ,                 
    fossil10 ,                 
    fossil11 ,                 
    fossil12 ,                 
    fossil13 ,                 
    fossil14 ,                 
    fossil15 ,                 
    fossilA ,                  
    fossilB ,                  
    fossilC ,                  
    fossilD ,                  
    fossil20                   
);                             

prset clockvarpr=iln; 
[prset shapepr=fixed(0.4544);]
prset nodeagepr=calibrated;
prset clockratepr=normal(0.001, 0.01);
lset nst=6;
lset rates=gamma;
propset ParsSPRClock(Tau,V)$prob=0 ExtSPRClock(Tau,V)$prob=0 NNIClock(Tau,V)$prob=0;  [fix tree topology]
startvals tau=birdtree;
mcmcp checkpoint=yes checkfreq=10000 filename=full_strict_ln.nex ngen=1400000;
mcmc  samplefreq=500 append=yes;
sump burninfrac=0.5 filename=full_strict_ln.nex;  
sumt burninfrac=0.5 conformat=figtree filename=full_strict_ln.nex;
log stop;
end;

