    calibrate fossil12  = offsetexponential(51.58, 72.8 );       
    calibrate fossil13  = offsetexponential(53.9 , 74   );       
    calibrate fossil14  = offsetexponential(55.6 , 74.8 );       
    calibrate fossil15  = offsetexponential(51.58, 72.8 );       
