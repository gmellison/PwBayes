#NEXUS

[set up the data]  
begin data;
dimensions ntax=15 nchar=1000;
format datatype=dna interleave=yes gap=- missing=?;
matrix
agthlsbnn  
allgtrmss  
aptndytsf  
atlntsrgr  
blrcrglrm  
calyptenn  
chatrplgc  
flmrsglcl  
frgtmgnfc  
hmprcncmt  
nyctbsgrn  
phlcrcrxc  
pygsclsdl  
sttrnscrp  
thlssrchc  
	;
end;

begin mrbayes;
log start filename=log.txt;

[set up the tree toplogy]
begin trees;
tree simtree= [&R] (allgtrmss,((((agthlsbnn,(calyptenn,(chatrplgc,hmprcncmt))),(nyctbsgrn,sttrnscrp)),(atlntsrgr,blrcrglrm)),(((aptndytsf,pygsclsdl),(flmrsglcl,thlssrchc)),(frgtmgnfc,phlcrcrxc))));
end;

[place the fossil nodes]
constraint root = 1-15;
constraint outgroup = agthlsbnn aptndytsf atlntsrgr blrcrglrm calyptenn chatrplgc flmrsglcl frgtmgnfc hmprcncmt nyctbsgrn phlcrcrxc pygsclsdl sttrnscrp thlssrchc;
constraint fossil1 = atlntsrgr blrcrglrm;
constraint fossil2 = agthlsbnn calyptenn chatrplgc hmprcncmt;

[fossil prior calibrations]
calibrate   root      = uniform(255.9, 299.8);
calibrate   outgroup  = offsetlognormal(66.7, 81.3, 5.3);  
calibrate   fossil1   = offsetexponential(28.3, 61.2);
calibrate   fossil2   = offsetexponential(51.58, 72.8 );

[set up priors]
prset brlenspr=clock:birthdeath;
prset clockvarpr=iln;
prset topologypr=constraints(root, outgroup, fossil1, fossil2);
prset clockratepr=normal(0.001, 0.01) ;
prset nodeagepr=calibrated;

[set up pairwise likelihood, with weight 1. JC substitution model]
lset nst=1;
lset usepairwise=yes;
lset pwweights=1 nsplits=10;

[disable tree update moves and set start tree]
propset ParsSPRClock(Tau,V)$prob=0 ExtSPRClock(Tau,V)$prob=0 NNIClock(Tau,V)$prob=0;
startvals tau=simtree;

[run the mcmc]
mcmc ngen=100000;

[summarize the output]
sump outputname=simulated.nex burninfrac=0.5;
sumt outputname=simulated.nex burninfrac=0.5 conformat=figtree;

log stop;
end;
